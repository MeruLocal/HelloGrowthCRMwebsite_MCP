{
  "$id": "market-facts.schema.json",
  "$defs": {
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref", "public_url"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "public_url": { "type": ["string", "null"] }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "claim_id", "claim_id_status", "claim_id_aliases", "scope_ref", "kind", "statement", "applies_to", "market", "status", "is_capability", "evidence", "source", "verified_on", "truth_version", "fact_version", "supersedes", "release_evidence_version", "commit_id", "publish_gates"],
      "properties": {
        "fact_id": { "type": "string", "pattern": "^[a-z]{2}\\.[a-z0-9-]+\\.[a-z0-9-]+$" },
        "claim_id": { "type": "string", "minLength": 1 },
        "claim_id_status": { "enum": ["provisional", "registry"] },
        "claim_id_aliases": { "type": "array", "items": { "type": "string" } },
        "scope_ref": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["price", "payment", "market", "attestation", "positioning"] },
        "statement": { "type": "string", "minLength": 1 },
        "applies_to": { "type": ["string", "null"] },
        "market": { "type": "string", "pattern": "^[a-z]{2}$" },
        "status": { "enum": ["capability", "roadmap"] },
        "is_capability": { "type": "boolean" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "source": { "type": "string", "minLength": 1 },
        "verified_on": { "$ref": "#/$defs/isoDate" },
        "truth_version": { "type": "string", "minLength": 1 },
        "fact_version": { "type": "integer", "minimum": 1 },
        "supersedes": { "type": ["string", "null"] },
        "release_evidence_version": { "type": "string", "minLength": 1 },
        "commit_id": { "type": "string", "minLength": 1 },
        "publish_gates": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "priceAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "unit"],
      "properties": { "amount": { "type": "number" }, "unit": { "type": "string", "minLength": 1 } }
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["billing_currency", "monthly", "annual", "applies_to", "source", "verified_on", "truth_version", "publish_gates", "pending_note"],
      "properties": {
        "billing_currency": { "const": "USD" },
        "monthly": { "$ref": "#/$defs/priceAmount" },
        "annual": { "$ref": "#/$defs/priceAmount" },
        "applies_to": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "verified_on": { "$ref": "#/$defs/isoDate" },
        "truth_version": { "type": "string", "minLength": 1 },
        "publish_gates": { "type": "array", "items": { "type": "string" } },
        "pending_note": { "type": "string", "minLength": 1 }
      }
    },
    "marketFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["market", "as_of", "fact_set_version", "market_facts_contract", "release_evidence_version", "price", "facts", "withheld"],
      "properties": {
        "market": { "type": "string", "pattern": "^[a-z]{2}$" },
        "as_of": { "$ref": "#/$defs/isoDate" },
        "fact_set_version": { "type": "integer", "minimum": 1 },
        "market_facts_contract": { "const": 1 },
        "release_evidence_version": { "type": "string", "minLength": 1 },
        "price": { "$ref": "#/$defs/price" },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "withheld": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "market", "status", "evidence_ref", "evidence_sha256", "observed_on", "approver", "expires_on"],
      "properties": {
        "gate_id": { "type": "string", "pattern": "^[a-z0-9-]+(:[a-z]{2})?$" },
        "market": { "type": "string", "pattern": "^([a-z]{2}|global)$" },
        "status": { "enum": ["unmet", "met", "revoked"] },
        "evidence_ref": { "type": ["string", "null"] },
        "evidence_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "observed_on": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "approver": { "type": ["string", "null"] },
        "expires_on": { "type": ["string", "null"] },
        "public_price_qualifier": { "type": "string" }
      }
    },
    "gatesFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["market_facts_contract", "release_evidence_version", "gates"],
      "properties": {
        "market_facts_contract": { "const": 1 },
        "release_evidence_version": { "type": "string", "minLength": 1 },
        "gates": { "type": "array", "items": { "$ref": "#/$defs/gate" } }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["market_facts_contract", "global_gates", "mandatory_gates_by_kind", "banned_prose_patterns", "withheld_topics", "withheld_message", "max_price_gate_days"],
      "properties": {
        "market_facts_contract": { "const": 1 },
        "global_gates": { "type": "array", "items": { "type": "string" } },
        "mandatory_gates_by_kind": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "banned_prose_patterns": { "type": "array", "items": { "type": "string" } },
        "withheld_topics": { "type": "array", "items": { "type": "string" } },
        "withheld_message": { "type": "string" },
        "max_price_gate_days": { "type": "integer" }
      }
    }
  }
}
