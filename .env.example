# mcp-bot-crawler - example environment
# Copy to .env and edit:  cp .env.example .env
# Every variable below is optional unless marked REQUIRED; the defaults shown are
# the ones the code actually falls back to.
#
# This file is committed. It must contain PLACEHOLDERS ONLY — never real keys.
# `.env` is git-ignored; that is where secrets belong.

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------
# "http" (the code default) runs the Streamable HTTP server on PORT, endpoint /sse.
# "stdio" for Claude Desktop / Cursor / any stdio MCP client.
TRANSPORT=stdio

# stdio sessions get the PUBLIC tool set unless this is "1" AND MCP_ADMIN_TOKEN
# (below) is set. WARNING: "1" exposes the content-write and personal-data
# tools to whatever launched the process. Operator use only.
# MCP_STDIO_TRUSTED=1

# Port for the HTTP transport. Ignored when TRANSPORT=stdio.
PORT=3008

# ---------------------------------------------------------------------------
# Rate limiting (HTTP transport)
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Optional shared rate-limit store (Upstash Redis, REST API). Set BOTH to share
# buckets across horizontally scaled instances — otherwise buckets are
# in-memory and per-process, so N instances enforce N× the configured limit.
# On store failure the limiter falls back to in-memory (local limiting, never
# unlimited).
# UPSTASH_REDIS_REST_URL=https://<db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>

# ---------------------------------------------------------------------------
# Crawl targets and politeness
# ---------------------------------------------------------------------------
# Default base URL for scan_website_bots / generate_robots_txt when none is given.
DEFAULT_TARGET_URL=https://hellogrowthcrm.com

# Default access-log file used by analyze_access_logs when no path is given.
DEFAULT_ACCESS_LOG=./samples/access.log

# Hard cap on how many sitemap pages a single scan will fetch.
# Keep this conservative — we are a polite citizen.
MAX_SITEMAP_PAGES=25

# Per-host delay between outbound fetches, milliseconds.
CRAWL_DELAY_MS=1000

# Per-request timeout, milliseconds.
HTTP_TIMEOUT_MS=10000

# Outbound User-Agent. Be honest — never spoof. Keep a contact URL in it.
CRAWLER_USER_AGENT=mcp-bot-crawler/1.0 (+https://hellogrowthcrm.com/bot-info)

# Where export_bot_report writes Markdown / JSON / CSV. Only authenticated
# sessions (MCP_ADMIN_TOKEN) may write, and only plain file names inside this
# directory. The public endpoint always returns the report inline.
REPORT_OUTPUT_DIR=./reports

# The ONLY directory an authenticated session may read through `logPath`
# (analyze_access_logs, export_bot_report, scan_website_bots,
# suggest_bot_policy) or `robotsTxtPath` (list_allowed_bots, list_blocked_bots).
# Unset = no caller may name a server file. Public callers are always refused;
# they send content inline as logText / robotsTxt. DEFAULT_ACCESS_LOG above is
# the operator's own choice and is still used when no path is given.
# LOG_DIR=/var/log/apache2

# Outbound fetches (fetch_page_content, crawl_pages, scan_website_bots,
# check_ai_extractability, validate_sitemaps, check_llms_txt) refuse private,
# loopback, link-local/metadata and CGNAT addresses, re-check every redirect,
# and cap bodies. LOCAL DEVELOPMENT ONLY: "1" allows loopback (127.0.0.0/8, ::1)
# so you can point the tools at a dev server. Never set this in production.
# SAFE_FETCH_ALLOW_PRIVATE=1

# Log verbosity: error | warn | info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Supabase - REQUIRED for the live-content tools only
# ---------------------------------------------------------------------------
# Needed by blog_*, help_*, newsletter_*, forms_* and analytics_social_proof.
# All other tools are read-mirrors of the website source and work without these.
# The service-role key grants full DB access. SECRET — never expose client-side.
# Supabase -> Project Settings -> API. Never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Privileged tool surface (finding C0)
# ---------------------------------------------------------------------------
# The Supabase key above is a SERVICE-ROLE key: it bypasses row-level security.
# So the tools that write content (blog_create, blog_update, blog_revalidate,
# help_create_article, help_update_article, newsletter_subscribe,
# newsletter_unsubscribe, forms_submit) and the tools that read personal data
# (newsletter_get_subscribers, forms_list_submissions, forms_get_submission,
# forms_export_csv) are NOT served on the public HTTP endpoint.
#
# Set MCP_ADMIN_TOKEN to unlock them for callers that send
# `Authorization: Bearer <token>`. Leave it UNSET and those 12 tools are not
# served at all — the default is fail-closed, so a forgotten variable can never
# re-open the endpoint. stdio is NOT trusted by default: it also needs
# MCP_STDIO_TRUSTED=1 (see Transport above).
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# MCP / SSE usage analytics -> GA4 Measurement Protocol
# See docs/MCP_ANALYTICS.md. Disabled unless ENABLE_MCP_ANALYTICS is exactly "true"
# AND both GA4_MEASUREMENT_ID and GA4_API_SECRET are set. Never commit real values.
#
# These must be set in the HOST environment for the deployed server — `.env` is
# git-ignored and does not travel with a push.
# ---------------------------------------------------------------------------
ENABLE_MCP_ANALYTICS=false
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Collect endpoint. Leave as-is; use GA4_VALIDATE below to reach the validator.
GA4_ENDPOINT=https://www.google-analytics.com/mp/collect

# Abort a telemetry send after N milliseconds.
GA4_TIMEOUT_MS=3000

# "true" tags every event with debug_mode:1 so the run appears in GA4 -> Admin ->
# DebugView. Without it, events land in Realtime/Events but DebugView stays empty
# - which reads exactly like "telemetry is broken". Events are still recorded
# normally. Turn OFF once verification is done.
GA4_DEBUG_MODE=false

# "true" POSTs to GA4's /debug/mp/collect validation endpoint instead and logs
# the returned validationMessages.
# NOTE: events sent this way are validated but NOT recorded. Use for a one-off
# payload check only — never leave this on in production.
GA4_VALIDATE=false

# ---------------------------------------------------------------------------
# Client IP for the rate limit and the outbound budget (src/utils/client-ip.ts)
# ---------------------------------------------------------------------------
# Default: forwarded headers are IGNORED and the TCP peer is the key. That is
# right when Node is exposed directly. Behind a reverse proxy on the same host
# (production: Cloudflare -> Apache -> Node) set TRUST_PROXY_HEADERS=true, or
# every caller shares the proxy's bucket and gets 429 almost at once.
# Headers are only believed from peers inside TRUSTED_PROXY_CIDRS.
#
# PRODUCTION (Cloudflare -> Apache -> Node): set TRUST_PROXY_HEADERS=true and put
# BOTH Cloudflare's published IPv4 and IPv6 ranges
#   https://www.cloudflare.com/ips-v4   https://www.cloudflare.com/ips-v6
# PLUS the local proxy address in TRUSTED_PROXY_CIDRS, e.g.
#   TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,<ips-v4 entries>,<ips-v6 entries>
# Otherwise every caller is keyed by a Cloudflare edge IP and shares buckets.
# Cloudflare changes these lists occasionally: refresh them periodically.
#
# CF-Connecting-IP is only believed with TRUST_CLOUDFLARE=true AND when the hop
# that delivered it (right-most X-Forwarded-For hop, or the socket peer without
# XFF) is inside CLOUDFLARE_CIDRS (same Cloudflare ranges). Default off.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
TRUST_CLOUDFLARE=false
CLOUDFLARE_CIDRS=

# Outbound fetches an anonymous client may trigger through crawl tools (each
# network fetch and redirect hop counts). Authenticated sessions are exempt.
OUTBOUND_BUDGET_PER_MIN=30
OUTBOUND_BUDGET_PER_HOUR=300
# Public per-call page cap (crawl_pages limit, scan_website_bots sampleSize,
# check_ai_extractability URLs, sitemap child expansion).
PUBLIC_MAX_PAGES_PER_CALL=5

# ---------------------------------------------------------------------------
# HTTP transport hardening (/sse)
# ---------------------------------------------------------------------------
# Host values accepted (entries without a port match any port). Others get 403.
# Behind Apache, keep ProxyPreserveHost On so the public host arrives intact.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],mcp.hellogrowthcrm.com
# Browser Origins accepted; requests without an Origin header always pass.
# "*" disables the Origin check (browser-hosted MCP clients anywhere).
MCP_ALLOWED_ORIGINS=http://localhost,https://localhost,http://127.0.0.1,https://127.0.0.1,http://[::1],https://[::1],https://mcp.hellogrowthcrm.com
MCP_MAX_BODY_BYTES=1048576
MCP_MAX_SESSIONS=1000
MCP_SESSION_IDLE_MS=1800000
