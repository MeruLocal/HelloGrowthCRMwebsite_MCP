# mcp-bot-crawler - example environment
# Copy to .env and edit:  cp .env.example .env
# Every variable below is optional unless marked REQUIRED; the defaults shown are
# the ones the code actually falls back to.
#
# This file is committed. It must contain PLACEHOLDERS ONLY — never real keys.
# `.env` is git-ignored; that is where secrets belong.

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------
# "stdio" (default) for Claude Desktop / Cursor / any stdio MCP client.
# "http" to run the Streamable HTTP + SSE server instead.
TRANSPORT=stdio

# Port for the HTTP transport. Ignored when TRANSPORT=stdio.
PORT=3008

# ---------------------------------------------------------------------------
# Rate limiting (HTTP transport)
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ---------------------------------------------------------------------------
# Crawl targets and politeness
# ---------------------------------------------------------------------------
# Default base URL for scan_website_bots / generate_robots_txt when none is given.
DEFAULT_TARGET_URL=https://hellogrowthcrm.com

# Default access-log file used by analyze_access_logs when no path is given.
DEFAULT_ACCESS_LOG=./samples/access.log

# Hard cap on how many sitemap pages a single scan will fetch.
# Keep this conservative — we are a polite citizen.
MAX_SITEMAP_PAGES=25

# Per-host delay between outbound fetches, milliseconds.
CRAWL_DELAY_MS=1000

# Per-request timeout, milliseconds.
HTTP_TIMEOUT_MS=10000

# Outbound User-Agent. Be honest — never spoof. Keep a contact URL in it.
CRAWLER_USER_AGENT=mcp-bot-crawler/1.0 (+https://hellogrowthcrm.com/bot-info)

# Where export_bot_report writes Markdown / JSON / CSV.
REPORT_OUTPUT_DIR=./reports

# Log verbosity: error | warn | info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Supabase - REQUIRED for the live-content tools only
# ---------------------------------------------------------------------------
# Needed by blog_*, help_*, newsletter_*, forms_* and analytics_social_proof.
# All other tools are read-mirrors of the website source and work without these.
# The service-role key grants full DB access. SECRET — never expose client-side.
# Supabase -> Project Settings -> API. Never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# MCP / SSE usage analytics -> GA4 Measurement Protocol
# See docs/MCP_ANALYTICS.md. Disabled unless ENABLE_MCP_ANALYTICS is exactly "true"
# AND both GA4_MEASUREMENT_ID and GA4_API_SECRET are set. Never commit real values.
#
# These must be set in the HOST environment for the deployed server — `.env` is
# git-ignored and does not travel with a push.
# ---------------------------------------------------------------------------
ENABLE_MCP_ANALYTICS=false
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Collect endpoint. Leave as-is; use GA4_VALIDATE below to reach the validator.
GA4_ENDPOINT=https://www.google-analytics.com/mp/collect

# Abort a telemetry send after N milliseconds.
GA4_TIMEOUT_MS=3000

# "true" tags every event with debug_mode:1 so the run appears in GA4 -> Admin ->
# DebugView. Without it, events land in Realtime/Events but DebugView stays empty
# - which reads exactly like "telemetry is broken". Events are still recorded
# normally. Turn OFF once verification is done.
GA4_DEBUG_MODE=false

# "true" POSTs to GA4's /debug/mp/collect validation endpoint instead and logs
# the returned validationMessages.
# NOTE: events sent this way are validated but NOT recorded. Use for a one-off
# payload check only — never leave this on in production.
GA4_VALIDATE=false
