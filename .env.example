# ---- mcp-bot-crawler configuration ------------------------------------------
# Copy to `.env` and fill in real values:  cp .env.example .env
#
# This file is committed. It must contain PLACEHOLDERS ONLY — never real keys.
# `.env` is git-ignored; that is where secrets belong.

# ---- Supabase ---------------------------------------------------------------
# Required for the blog, help, newsletter, forms and analytics tools.
# The service-role key grants full DB access. SECRET — never expose client-side.
# Supabase -> Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct Postgres connection string — ONLY needed for scripts/setup-mcp-tracking.ts,
# whose DDL cannot go through the service-role REST key. SECRET.
# Supabase -> Project Settings -> Database -> Connection string -> URI.
# SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# ---- Resend (optional — used by the analytics report tool) -------------------
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Your Brand <forms@mail.example.com>
RESEND_TO=alerts@example.com

# ---- Crawler behaviour -------------------------------------------------------
# Default access-log file used by analyze_access_logs when no path is given.
DEFAULT_ACCESS_LOG=./samples/access.log

# Default base URL for scan_website_bots / generate_robots_txt when none is given.
DEFAULT_TARGET_URL=https://hellogrowthcrm.com

# How many pages from sitemap.xml the crawler may fetch in one run.
# Keep this conservative — we are a polite citizen.
MAX_SITEMAP_PAGES=25

# Per-host crawl delay in milliseconds. Increase for production / shared hosts.
CRAWL_DELAY_MS=1000

# HTTP request timeout for outbound fetches (ms).
HTTP_TIMEOUT_MS=10000

# User-Agent the crawler identifies itself with. Be honest — never spoof.
CRAWLER_USER_AGENT=mcp-bot-crawler/1.0 (+https://hellogrowthcrm.com/bot-info)

# Path where export_bot_report writes generated reports.
REPORT_OUTPUT_DIR=./reports

# Log verbosity: error | warn | info | debug
LOG_LEVEL=info

# ---- Transport ---------------------------------------------------------------
# stdio (default, for local MCP clients) | http (for the hosted endpoint)
TRANSPORT=stdio
PORT=3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ---- GA4 telemetry (see docs/MCP_ANALYTICS.md) -------------------------------
# OFF unless ENABLE_MCP_ANALYTICS is exactly "true" AND both GA4 vars are set.
# These must be set in the HOST environment for the deployed server — `.env` is
# git-ignored and does not travel with a push.
ENABLE_MCP_ANALYTICS=false
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your-measurement-protocol-api-secret
# Optional overrides:
# GA4_ENDPOINT=https://www.google-analytics.com/mp/collect
# GA4_TIMEOUT_MS=3000

# Tag every event with debug_mode:1 so it appears in GA4 -> Admin -> DebugView.
# Events are still recorded normally. Turn OFF once verification is done.
GA4_DEBUG_MODE=false

# Send to GA4's validation endpoint instead and log validationMessages.
# NOTE: events sent this way are validated but NOT recorded. Use for a one-off
# payload check only — never leave this on in production.
GA4_VALIDATE=false
