+  const token = "tok";
+
+  afterEach(() => vi.unstubAllGlobals());
+
+  function stubPipeline(incrResult: number): ReturnType<typeof vi.fn> {
+    const mock = vi.fn(async () => ({
+      ok: true,
+      json: async () => [{ result: incrResult }, { result: 1 }],
+    }));
+    vi.stubGlobal("fetch", mock);
+    return mock;
